# Copie para .env e ajuste. Todas as variaveis sao opcionais.

# Endereco de escuta. Use 0.0.0.0 para liberar na rede local.
ETIQUETA_HOST=127.0.0.1
ETIQUETA_PORT=8000

# Onde ficam os modelos salvos.
# ETIQUETA_TEMPLATES_DIR=C:/etiquetas/modelos

# Impressao direta vem DESLIGADA. Ligue conscientemente: ela envia bytes para
# um equipamento fisico da rede.
ETIQUETA_ALLOW_PRINTING=0

# Impressoras de rede: Nome=host:porta, separadas por ponto e virgula.
# ETIQUETA_PRINTERS=Expedicao=192.168.0.50:9100;Producao=192.168.0.51
